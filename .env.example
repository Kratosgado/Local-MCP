# Copy this to .env and fill in your values
# cp .env.example .env

# ── REQUIRED ──────────────────────────────────────────────────────────────

# Public HTTPS URL of this server — required for claude.ai web OAuth to work.
# Run: ngrok http 3000  or  cloudflared tunnel --url http://localhost:3000
# then paste the URL here.
PUBLIC_URL=https://your-tunnel-url.ngrok-free.app

# Static bearer token for non-OAuth clients (curl, Claude Code CLI, etc.)
# Generate one with: openssl rand -hex 32
MCP_AUTH_TOKEN=your-strong-random-token-here

# ── OPTIONAL ──────────────────────────────────────────────────────────────
# Root directory the MCP server is allowed to access
FS_ROOT=/host-home

# Server port
PORT=3000

# Set to "production" to enforce auth checks
NODE_ENV=production

